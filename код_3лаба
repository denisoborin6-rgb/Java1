package ru.surname.geometry;

public class Треугольник extends Фигура implements PolygonalChainProvider { // Задания 4.4 и 5.7
    private final Точка a, b, c; // Три вершины

    public Треугольник(Точка a, Точка b, Точка c) {
        if (a == null || b == null || c == null) throw new IllegalArgumentException("Точки не могут быть null");
        this.a = a;
        this.b = b;
        this.c = c;
    }

    @Override
    public double площадь() { // Площадь по формуле Герона
        double ab = Ломаная.расстояние(a, b); // Сторона AB
        double bc = Ломаная.расстояние(b, c); // Сторона BC
        double ca = Ломаная.расстояние(c, a); // Сторона CA
        double p = (ab + bc + ca) / 2; // Полупериметр
        return Math.sqrt(p * (p - ab) * (p - bc) * (p - ca)); // Формула
    }

    @Override
    public Ломаная getPolygonalChain() { // Задание 5.7: контур треугольника
        return new Ломаная(a, b, c, a); // 4 точки, последняя замыкает
    }

    @Override
    public String toString() {
        return "Треугольник " + a + " " + b + " " + c;
    }
}
