    private int y; // Координата Y

    public Точка(int x, int y) { // Конструктор точки
        this.x = x;
        this.y = y;
    }

    public int getX() { return x; } // Геттер X
    public int getY() { return y; } // Геттер Y
    public void setX(int x) { this.x = x; } // Сеттер X (для сдвига)
    public void setY(int y) { this.y = y; } // Сеттер Y (для сдвига)

    @Override
    public Точка clone() { // Задание 8.4: клонируем объект
        try {
            return (Точка) super.clone(); // Создаем точную копию
        } catch (CloneNotSupportedException e) {
            throw new AssertionError("Клонирование не поддерживается", e);
