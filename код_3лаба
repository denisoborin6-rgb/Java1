package ru.surname.tree;

public class Узел { // Задание 2.4: Узел дерева
    private Integer значение; // Само число (null, если пусто)
    private Узел родитель; // Ссылка на родителя
    private Узел левыйПотомок; // Левый ребенок
    private Узел правыйПотомок; // Правый ребенок

    public Узел() {} // Пустой конструктор

    public void добавить(int новое) { // Добавление значения
        if (значение == null) { // Если узел пустой
            значение = новое; // Записываем сюда
            return;
        }
        if (новое > значение) { // Если новое больше текущего
            if (правыйПотомок == null) { // И правого нет
                правыйПотомок = new Узел(); // Создаем
                правыйПотомок.родитель = this; // Ссылаемся на родителя
            }
            правыйПотомок.добавить(новое); // Рекурсивно идем вправо
        } else { // Иначе (меньше или равно)
            if (левыйПотомок == null) {
                левыйПотомок = new Узел();
                левыйПотомок.родитель = this;
            }
            левыйПотомок.добавить(новое); // Рекурсивно идем влево
        }
    }

    public boolean содержит(int искомое) { // Поиск значения
        if (значение == null) return false; // Пусто - нет
        if (значение == искомое) return true; // Нашли
        if (искомое > значение) { // Если больше - ищем справа
            return правыйПотомок != null && правыйПотомок.содержит(искомое);
        } else { // Иначе - слева
            return левыйПотомок != null && левыйПотомок.содержит(искомое);
        }
    }

    public void удалить(int искомое) { // Удаление узла
        if (значение == null) return; // Пусто
        if (значение == искомое) { // Нашли
            удалитьТекущий(); // Вызываем логику удаления
            return;
        }
        if (искомое > значение && правыйПотомок != null) { // Ищем справа
            правыйПотомок.удалить(искомое);
        } else if (искомое < значение && левыйПотомок != null) { // Ищем слева
            левыйПотомок.удалить(искомое);
        }
    }

    private void удалитьТекущий() { // Сложная логика удаления (сохранение потомков)
        if (левыйПотомок == null && правыйПотомок == null) { // Случай 1: лист
            значение = null; // Обнуляем
            отцепитьОтРодителя(); // Убираем ссылку у родителя
            return;
        }
        if (левыйПотомок == null) { // Случай 2: только правый
            значение = правыйПотомок.значение; // Копируем значение
            левыйПотомок = правыйПотомок.левыйПотомок; // Переносим левый
            правыйПотомок = правыйПотомок.правыйПотомок; // Переносим правый
            if (левыйПотомок != null) левыйПотомок.родитель = this;
            if (правыйПотомок != null) правыйПотомок.родитель = this;
            return;
        }
        if (правыйПотомок == null) { // Случай 3: только левый
            значение = левыйПотомок.значение; // Копируем значение
            правыйПотомок = левыйПотомок.правыйПотомок; // Переносим
            левыйПотомок = левыйПотомок.левыйПотомок;
            if (левыйПотомок != null) левыйПотомок.родитель = this;
            if (правыйПотомок != null) правыйПотомок.родитель = this;
            return;
        }
        Узел мин = правыйПотомок.минимум(); // Случай 4: оба ребенка
        значение = мин.значение; // Берем минимум из правого поддерева
        мин.удалитьТекущий(); // Удаляем этот минимум
    }

    private void отцепитьОтРодителя() { // Удаление ссылки на себя
        if (родитель == null) return;
        if (родитель.левыйПотомок == this) родитель.левыйПотомок = null;
        else if (родитель.правыйПотомок == this) родитель.правыйПотомок = null;
    }

    private Узел минимум() { // Поиск минимального элемента
        Узел тек = this;
        while (тек.левыйПотомок != null) тек = тек.левыйПотомок; // Идем влево до конца
        return тек;
    }

    @Override
    public String toString() { // Вывод дерева
        StringBuilder sb = new StringBuilder();
        обход(sb); // Запускаем обход
        return sb.toString().trim(); // Возвращаем строку
    }

    private void обход(StringBuilder sb) { // Pre-order (Корень-Левый-Правый)
        if (значение != null) sb.append(значение).append(" "); // Сначала корень
        if (левыйПотомок != null) левыйПотомок.обход(sb); // Потом левое
        if (правыйПотомок != null) правыйПотомок.обход(sb); // Потом правое
    }
}
