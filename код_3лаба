        return new Ломаная(всеТочки.toArray(new Точка[0])); // Создаем новую
    }

    public static double степень(String x, String y) { // Задание 7.3
        return pow(parseInt(x), parseInt(y)); // Используем короткие имена
    }

    private static int вДиапазоне(String приглашение, int min, int max) { // Проверка ввода для меню
        while (true) {
            System.out.print(приглашение);
            String стр = SC.nextLine().trim();
            try {
                int значение = parseInt(стр);
                if (значение >= min && значение <= max) return значение; // Если в диапазоне
            } catch (NumberFormatException ignored) {}
            System.out.println("Ошибка: введите число от " + min + " до " + max + ".");
        }
    }

