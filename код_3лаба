package ru.surname.geometry;

import java.util.ArrayList;
import java.util.List;

public class Ломаная implements Измеримый, PolygonalChainProvider { // Реализует интерфейсы для 5.5 и 5.7
    protected final List<Точка> точки; // Список точек

    public Ломаная(Точка... точки) { // Конструктор (принимает любое кол-во точек)
        if (точки == null || точки.length < 2) { // Проверка на минимум 2 точки
            throw new IllegalArgumentException("Ломаная должна содержать минимум 2 точки");
        }
        this.точки = new ArrayList<>(); // Инициализация списка
        for (Точка т : точки) { // Перебор переданных точек
            if (т == null) throw new IllegalArgumentException("Точка не может быть null");
            this.точки.add(т); // Добавление в список
        }
    }

    public int размер() { return точки.size(); } // Количество точек

    public Точка getТочка(int индекс) { // Получение точки по индексу
        if (индекс < 0 || индекс >= точки.size()) { // Проверка границ
            throw new IndexOutOfBoundsException("Некорректный индекс: " + индекс);
        }
        return точки.get(индекс); // Возврат точки
    }

    @Override
    public double длина() { // Задание 5.5: расчет длины
        double сумма = 0; // Сумма длин сегментов
        for (int i = 0; i < точки.size() - 1; i++) { // Проход по парам точек
            сумма += расстояние(точки.get(i), точки.get(i + 1)); // Суммируем расстояние
        }
        return сумма; // Возврат итоговой длины
    }

    protected static double расстояние(Точка a, Точка b) { // Вспомогательный метод (дистанция)
        int dx = a.getX() - b.getX(); // Разность по X
        int dy = a.getY() - b.getY(); // Разность по Y
        return Math.sqrt(dx * dx + dy * dy); // Формула расстояния
    }

    @Override
    public Ломаная getPolygonalChain() { // Задание 5.7: ломаная возвращает саму себя
        return this;
    }

    @Override
    public boolean equals(Object obj) { // Задание 6.4: сравнение ломаных
        if (this == obj) return true;
        if (obj == null || getClass() != obj.getClass()) return false;
        Ломаная other = (Ломаная) obj;
        return this.точки.equals(other.точки); // Сравниваем списки точек (вызовет equals у Точки)
    }

    @Override
    public int hashCode() {
        return точки.hashCode(); // Хэш по списку точек
    }

    @Override
    public String toString() {
        return "Ломаная " + точки; // Вывод в строку
    }
}
